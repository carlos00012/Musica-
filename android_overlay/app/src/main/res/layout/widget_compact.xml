<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C201C"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_artwork_placeholder"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="♫"
        android:textColor="#B8F36A"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tu música"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reproduce una canción"
            android:textColor="#B8BDB8"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_previous"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFF" />
    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_play_pause"
        android:src="@android:drawable/ic_media_play"
        android:tint="#B8F36A" />
    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_next"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFF" />
</LinearLayout>
